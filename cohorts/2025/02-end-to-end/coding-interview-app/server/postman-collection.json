{
  "info": {
    "_postman_id": "coding-interview-api",
    "name": "Coding Interview App API",
    "description": "API collection for the collaborative coding interview application. Supports code execution in 7 programming languages via Docker sandbox.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Create Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:3001/api/sessions",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3001",
              "path": [
                "api",
                "sessions"
              ]
            },
            "description": "Creates a new collaborative coding session. Returns a unique sessionId and shareable link."
          },
          "response": []
        },
        {
          "name": "Get Session Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3001/api/sessions/12345678",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3001",
              "path": [
                "api",
                "sessions",
                "12345678"
              ]
            },
            "description": "Retrieves details of a specific session. SessionId must be 8 hexadecimal characters.\nReplace '12345678' with an actual sessionId (e.g., 'a1b2c3d4')."
          },
          "response": []
        }
      ],
      "description": "Manage collaborative coding sessions"
    },
